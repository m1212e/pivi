{
	"title": "pivi plugin protocol",
	"protocol": 1,
	"transport": "JSON-RPC 2.0 over the container entrypoint’s stdin/stdout, one UTF-8 JSON message per line. stderr is the log stream; nothing else may be written to stdout.",
	"features": ["dashboard", "screen", "playback", "skipSegments", "auth"],
	"methods": [
		{
			"method": "plugin/ready",
			"from": "plugin",
			"kind": "notification",
			"description": "First message, sent once the plugin can receive requests. Nothing else is sent to it before.",
			"params": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"type": "object",
				"properties": {
					"protocol": {
						"type": "integer",
						"exclusiveMinimum": 0,
						"maximum": 9007199254740991
					}
				},
				"required": ["protocol"]
			}
		},
		{
			"method": "host/activate",
			"from": "host",
			"kind": "notification",
			"description": "Sent once after ready: the plugin may start publishing."
		},
		{
			"method": "host/shutdown",
			"from": "host",
			"kind": "notification",
			"description": "The plugin should exit. It is killed shortly after regardless."
		},
		{
			"method": "plugin/publishDashboard",
			"from": "plugin",
			"kind": "notification",
			"feature": "dashboard",
			"description": "The cards this plugin contributes to the home dashboard. Replaces the last set.",
			"params": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"type": "object",
				"properties": {
					"theme": {
						"type": "object",
						"properties": {
							"accentColor": {
								"type": "string"
							},
							"logoUrl": {
								"type": "string"
							},
							"cornerRadius": {
								"type": "string",
								"enum": ["none", "sm", "md", "lg"]
							}
						}
					},
					"cards": {
						"type": "array",
						"items": {
							"oneOf": [
								{
									"type": "object",
									"properties": {
										"kind": {
											"type": "string",
											"const": "resume"
										},
										"id": {
											"type": "string"
										},
										"title": {
											"type": "string"
										},
										"subtitle": {
											"type": "string"
										},
										"image": {
											"type": "string"
										},
										"progress": {
											"type": "number",
											"minimum": 0,
											"maximum": 1
										},
										"action": {
											"oneOf": [
												{
													"type": "object",
													"properties": {
														"type": {
															"type": "string",
															"const": "screen"
														},
														"screenId": {
															"type": "string"
														}
													},
													"required": ["type", "screenId"]
												},
												{
													"type": "object",
													"properties": {
														"type": {
															"type": "string",
															"const": "session"
														},
														"sessionId": {
															"type": "string"
														}
													},
													"required": ["type", "sessionId"]
												},
												{
													"type": "object",
													"properties": {
														"type": {
															"type": "string",
															"const": "deepLink"
														},
														"target": {
															"type": "string"
														}
													},
													"required": ["type", "target"]
												}
											]
										}
									},
									"required": ["kind", "id", "title", "subtitle", "image", "progress", "action"]
								},
								{
									"type": "object",
									"properties": {
										"kind": {
											"type": "string",
											"const": "suggestion"
										},
										"id": {
											"type": "string"
										},
										"title": {
											"type": "string"
										},
										"meta": {
											"type": "string"
										},
										"image": {
											"type": "string"
										},
										"action": {
											"oneOf": [
												{
													"type": "object",
													"properties": {
														"type": {
															"type": "string",
															"const": "screen"
														},
														"screenId": {
															"type": "string"
														}
													},
													"required": ["type", "screenId"]
												},
												{
													"type": "object",
													"properties": {
														"type": {
															"type": "string",
															"const": "session"
														},
														"sessionId": {
															"type": "string"
														}
													},
													"required": ["type", "sessionId"]
												},
												{
													"type": "object",
													"properties": {
														"type": {
															"type": "string",
															"const": "deepLink"
														},
														"target": {
															"type": "string"
														}
													},
													"required": ["type", "target"]
												}
											]
										}
									},
									"required": ["kind", "id", "title", "meta", "image", "action"]
								}
							]
						}
					}
				},
				"required": ["cards"]
			}
		},
		{
			"method": "plugin/publishScreen",
			"from": "plugin",
			"kind": "notification",
			"feature": "screen",
			"description": "A declarative screen. Replaces the last version of the screen with that id.",
			"params": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"type": "object",
				"properties": {
					"screenId": {
						"type": "string"
					},
					"theme": {
						"type": "object",
						"properties": {
							"accentColor": {
								"type": "string"
							},
							"logoUrl": {
								"type": "string"
							},
							"cornerRadius": {
								"type": "string",
								"enum": ["none", "sm", "md", "lg"]
							}
						}
					},
					"root": {
						"$ref": "#/$defs/__schema0"
					}
				},
				"required": ["screenId", "root"],
				"$defs": {
					"__schema0": {
						"oneOf": [
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "container"
									},
									"direction": {
										"type": "string",
										"enum": ["row", "column"]
									},
									"children": {
										"type": "array",
										"items": {
											"$ref": "#/$defs/__schema0"
										}
									}
								},
								"required": ["type", "direction", "children"]
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "text"
									},
									"value": {
										"type": "string"
									},
									"variant": {
										"type": "string",
										"enum": ["title", "subtitle", "body"]
									}
								},
								"required": ["type", "value"]
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "image"
									},
									"src": {
										"type": "string"
									},
									"aspect": {
										"type": "string",
										"enum": ["video", "poster", "square"]
									}
								},
								"required": ["type", "src"]
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "button"
									},
									"label": {
										"type": "string"
									},
									"onSelect": {
										"type": "string"
									},
									"action": {
										"oneOf": [
											{
												"type": "object",
												"properties": {
													"type": {
														"type": "string",
														"const": "screen"
													},
													"screenId": {
														"type": "string"
													}
												},
												"required": ["type", "screenId"]
											},
											{
												"type": "object",
												"properties": {
													"type": {
														"type": "string",
														"const": "session"
													},
													"sessionId": {
														"type": "string"
													}
												},
												"required": ["type", "sessionId"]
											},
											{
												"type": "object",
												"properties": {
													"type": {
														"type": "string",
														"const": "deepLink"
													},
													"target": {
														"type": "string"
													}
												},
												"required": ["type", "target"]
											}
										]
									}
								},
								"required": ["type", "label"]
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "toggle"
									},
									"label": {
										"type": "string"
									},
									"value": {
										"type": "boolean"
									},
									"onChange": {
										"type": "string"
									}
								},
								"required": ["type", "label", "value", "onChange"]
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "textInput"
									},
									"label": {
										"type": "string"
									},
									"placeholder": {
										"type": "string"
									},
									"secret": {
										"type": "boolean"
									},
									"onSubmit": {
										"type": "string"
									}
								},
								"required": ["type", "label", "onSubmit"]
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"type": "string",
										"const": "list"
									},
									"items": {
										"type": "array",
										"items": {
											"$ref": "#/$defs/__schema0"
										}
									}
								},
								"required": ["type", "items"]
							}
						]
					}
				}
			}
		},
		{
			"method": "host/uiEvent",
			"from": "host",
			"kind": "notification",
			"feature": "screen",
			"description": "The user interacted with a node of a published screen that carried an event id.",
			"params": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"type": "object",
				"properties": {
					"screenId": {
						"type": "string"
					},
					"eventId": {
						"type": "string"
					},
					"value": {
						"type": ["string", "boolean"]
					}
				},
				"required": ["screenId", "eventId"]
			}
		},
		{
			"method": "plugin/publishAuth",
			"from": "plugin",
			"kind": "notification",
			"feature": "auth",
			"description": "A sign-in for the user to complete on another device (a device code, or a login URL for the phone).",
			"params": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"anyOf": [
					{
						"type": "object",
						"properties": {
							"verificationUrl": {
								"type": "string"
							},
							"verificationUrlComplete": {
								"type": "string"
							},
							"userCode": {
								"type": "string"
							},
							"expiresInSeconds": {
								"type": "number"
							},
							"pollIntervalSeconds": {
								"type": "number"
							},
							"status": {
								"type": "string",
								"enum": ["pending", "complete", "expired", "error"]
							}
						},
						"required": [
							"verificationUrl",
							"userCode",
							"expiresInSeconds",
							"pollIntervalSeconds",
							"status"
						]
					},
					{
						"type": "object",
						"properties": {
							"loginUrl": {
								"type": "string"
							},
							"redirectUrl": {
								"type": "string"
							},
							"state": {
								"type": "string"
							},
							"status": {
								"type": "string",
								"enum": ["pending", "complete", "error"]
							}
						},
						"required": ["loginUrl", "redirectUrl", "state", "status"]
					}
				]
			}
		},
		{
			"method": "host/oauthCode",
			"from": "host",
			"kind": "notification",
			"feature": "auth",
			"description": "The phone finished a login URL handoff and the provider redirected back; `state` is the plugin’s own.",
			"params": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"type": "object",
				"properties": {
					"code": {
						"type": "string"
					},
					"state": {
						"type": "string"
					}
				},
				"required": ["code", "state"]
			}
		},
		{
			"method": "plugin/getPublicOrigin",
			"from": "plugin",
			"kind": "request",
			"feature": "auth",
			"description": "A base URL the phone can reach this device on, for building a redirect URI.",
			"result": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"type": "object",
				"properties": {
					"origin": {
						"type": "string"
					}
				},
				"required": ["origin"]
			}
		},
		{
			"method": "plugin/resolveStream",
			"from": "host",
			"kind": "request",
			"feature": "playback",
			"description": "Resolve a session id to a playable stream. URLs must be on a domain the manifest declares.",
			"params": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"type": "object",
				"properties": {
					"sessionId": {
						"type": "string"
					},
					"maxHeight": {
						"type": "number"
					}
				},
				"required": ["sessionId"]
			},
			"result": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"type": "object",
				"properties": {
					"videoUrl": {
						"type": "string"
					},
					"audioUrl": {
						"type": "string"
					},
					"vcodec": {
						"type": "string"
					},
					"acodec": {
						"type": "string"
					},
					"videoContainer": {
						"type": "string",
						"enum": ["mp4", "webm"]
					},
					"audioContainer": {
						"type": "string",
						"enum": ["mp4", "webm"]
					},
					"title": {
						"type": "string"
					},
					"duration": {
						"type": "number"
					},
					"subtitleTracks": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"language": {
									"type": "string"
								},
								"label": {
									"type": "string"
								},
								"kind": {
									"type": "string",
									"enum": ["caption", "transcription"]
								},
								"url": {
									"type": "string"
								},
								"format": {
									"type": "string",
									"const": "vtt"
								}
							},
							"required": ["language", "kind", "url", "format"]
						}
					}
				},
				"required": ["videoUrl", "vcodec", "videoContainer", "title", "duration"]
			}
		},
		{
			"method": "plugin/resolveSkipSegments",
			"from": "host",
			"kind": "request",
			"feature": "skipSegments",
			"description": "Skippable stretches of a session’s stream.",
			"params": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"type": "object",
				"properties": {
					"sessionId": {
						"type": "string"
					}
				},
				"required": ["sessionId"]
			},
			"result": {
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"type": "object",
				"properties": {
					"segments": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"startSeconds": {
									"type": "number"
								},
								"endSeconds": {
									"type": "number"
								},
								"label": {
									"type": "string"
								}
							},
							"required": ["startSeconds", "endSeconds", "label"]
						}
					}
				},
				"required": ["segments"]
			}
		}
	]
}
