{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"customConditions": ["pivi-source"],
		"paths": {
			"#lib/*": ["./src/lib/*"],
			"#api/*": ["./src/api/*"]
		}
	},
	"include": ["src", "drizzle.config.ts", "apps", "packages/*/src", "packages/*/test"]
}
