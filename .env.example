# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# YouTube plugin (plugins/youtube) — browsing/search goes through a
# self-hosted Invidious instance (see docker-compose.yaml and
# plugins/youtube/invidious.ts); direct InnerTube browse/search calls
# don't work reliably for a signed-in session (see SKETCH.md). The
# "Sign in with Google" button still goes through youtubei.js directly
# (plugins/youtube/innertube.ts) and needs no registered Google Cloud
# OAuth client or API key.
INVIDIOUS_URL="http://localhost:3000"
# Internal secrets for the invidious/invidious-companion pair — not
# credentials for anything external. Generate with `openssl rand -hex 16`.
INVIDIOUS_HMAC_KEY=""
INVIDIOUS_COMPANION_KEY=""
