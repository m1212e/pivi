{
	// This file is JSONC: fallow reads these comments; generic JSON tools may not.
	"$schema": "./node_modules/fallow/schema.json",
	// deploy/pivi-server.mjs is the production entry point (the systemd unit
	// runs it directly; see DEPLOYMENT.md), so nothing imports it and the
	// module graph can only see it as an unreachable file.
	"entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}", "deploy/pivi-server.mjs"],
	"ignoreFindings": ["src/lib/api/rumbleClient/**"],
	// Registered by URL string (navigator.serviceWorker.register), not an
	// import, so the static module graph can't see it's reachable.
	"dynamicallyLoaded": ["static/remote/sw.js"],
	// src/lib/api/rumbleClient/* is regenerated wholesale from the GraphQL
	// schema on every dev/build run (see src/api/handlers/register.ts) --
	// its own unused-export/unused-type findings are just whatever fields
	// the schema happens to expose that this app doesn't currently query,
	// not something to hand-edit here (the next generation would just
	// reintroduce them). `ignoreFindings`, not `ignorePatterns`, since other
	// files still genuinely import real symbols from it and need it to stay
	// part of the module graph.
	// Both actually used, just invisible to static import-graph analysis:
	// `pg` is drizzle-orm/node-postgres's own runtime driver (src/api/db/
	// index.ts imports the drizzle wrapper, never `pg` by name), and
	// `@tailwindcss/typography` is pulled in via a CSS `@plugin` directive
	// (src/routes/layout.css), not a JS/TS import.
	//
	// And `vscode-jsonrpc` / `zod`, which apps/youtube/package.json lists for
	// the app image's build (see its Dockerfile): they're imported by sdk/, which
	// gets bundled into the image, never by the app's own files, so that manifest
	// can't be seen using them. Both are real dependencies of the host too.
	//
	// And the two @inlang plugins, which project.inlang/settings.json loads by
	// path (`modules`), never by import.
	"ignoreDependencies": [
		"pg",
		"@tailwindcss/typography",
		"vscode-jsonrpc",
		"zod",
		"@inlang/plugin-message-format",
		"@inlang/plugin-m-function-matcher"
	],
	"duplicates": {
		// Hide pair-only clones; focus on widespread copy-paste
		// worth refactoring. Lower to 2 to report every duplicate pair.
		"minOccurrences": 3,
		// Regenerated from the GraphQL schema, repeated field shapes are expected.
		"ignore": ["src/lib/api/rumbleClient/**"]
		// Common additions (uncomment to enable):
		// "ignore": [
		//   "**/lib/**",          // for repos that publish transpiled output to lib/
		//   "**/legacy/**",       // for repos with legacy-build artifacts
		//   "**/__generated__/**", // Relay, GraphQL Code Generator
		//   "**/generated/**"     // OpenAPI, Protobuf codegen
		// ]
	},
	// Called by vscode-jsonrpc itself once a reader/writer is wired into a
	// MessageConnection, so no call site exists in our code.
	"usedClassMembers": [
		{ "extends": "AbstractMessageReader", "members": ["listen"] },
		{ "extends": "AbstractMessageWriter", "members": ["write", "end"] }
	],
	"rules": {
		"unused-dependencies": "warn",
		// `dependencies` is exactly what the nix runtime tree installs (see
		// nix/package.nix's mkNodeModules), so it must hold what the built server
		// loads unbundled -- drizzle-kit included, which pivi-db-push runs even
		// though only drizzle.config.ts and specs import it. Client-only packages
		// (lucide, qr-code-styling, ...) are bundled by vite and belong in
		// devDependencies, so both of these checks point the wrong way here.
		"test-only-dependencies": "off",
		"dev-dependencies-in-production": "off"
	},
	"ignoreExports": [
		{
			"file": "src/api/appManagementService.ts",
			"exports": ["*"]
		},
		{
			"file": "src/lib/apps/management.ts",
			"exports": ["*"]
		}
	]
}
