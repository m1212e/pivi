{
	"name": "my-app",
	"private": true,
	"version": "0.0.16",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"bun run dev:server\" \"bun run dev:docker\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"app:build": "bun scripts/apps.ts build",
		"apps:build-all": "bun scripts/apps.ts build-all",
		"apps:protocol": "bun scripts/apps.ts protocol",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:start": "docker compose up",
		"dev:docker": "docker compose up",
		"dev:server": "svelte-kit sync && vite --host",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@inlang/plugin-m-function-matcher": "2.4.3",
		"@inlang/plugin-message-format": "4.6.0",
		"@lucide/svelte": "^1.72.0",
		"@m1212e/rumble": "^0.33.0",
		"@noble/ciphers": "^2.4.0",
		"@noble/curves": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/node-cron": "^3.0.11",
		"@types/pg": "^8.23.1",
		"@types/ws": "^8.18.2",
		"@urql/core": "^6.0.3",
		"@urql/exchange-graphcache": "^9.0.2",
		"@vitest/browser-playwright": "^5.1.0",
		"concurrently": "^10.0.7",
		"dexie": "^4.4.7",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fallow": "^3.42.0",
		"globals": "^17.14.0",
		"graphql": "^17.1.0",
		"graphql-yoga": "^6.1.0",
		"lefthook": "^2.2.2",
		"node-cron": "^4.6.0",
		"playwright": "^1.65.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"qr-code-styling": "^1.9.2",
		"shaka-player": "^5.3.4",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-inview": "^4.0.5",
		"svelte-sonner": "^1.2.3",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vscode-jsonrpc": "^10.0.0",
		"wonka": "^6.3.6",
		"ws": "^8.23.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#api/*": "./src/api/*",
		"#sdk/*": "./sdk/*"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.10.0",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"drizzle-orm": "1.0.0-rc.5-ab785fc",
		"microsandbox": "^0.7.15",
		"nanoid": "^6.0.2",
		"pg": "^8.23.1"
	}
}
